# Six-table report core. student_growth must contain the new six-table schema.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=report_core
DB_PASSWORD=
LEGACY_DB_NAME=student_growth_legacy
REPORT_DB_NAME=student_growth
SCHOOL_ID=1
PORT=9000
JWT_SECRET=
CORS_ORIGIN=https://school.example.com
CARD_PRINT_KEY=
PUBLIC_WEB_URL=https://school.example.com
REPORT_FILES_DIR=/var/lib/student-growth/report-core-files
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_MODEL=qwen3.6-plus
LLM_API_KEY=
# Only use for initial administrator creation; remove afterwards.
CORE_BOOTSTRAP_PASSWORD=
# Explicit historical migration selection; audit is default.
MIGRATE_TERM_IDS=

# Optional face authentication: disabled until real-person/PAD acceptance.
FACE_AUTH_ENABLED=0
FACE_AUTH_KEY_ID=
# JSON object: key IDs -> independent base64-encoded 32-byte AES keys.
FACE_AUTH_KEYS=
FACE_AUTH_PYTHON=/opt/student-growth/face-venv/bin/python
FACE_AUTH_MODEL_DIR=/var/lib/student-growth/face-models
FACE_AUTH_MATCH_THRESHOLD=0.65
# Set only behind a trusted, same-host TLS reverse proxy.
TRUST_PROXY_LOOPBACK=0
