# ==============================================================================
# 六育学生成长评价系统 - 后端生产环境变量模板 (backend.env.example)
# ==============================================================================

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_growth
DB_USER=root
DB_PASSWORD=your_production_mysql_password
DB_CONNECTION_LIMIT=20

# JWT 鉴权配置
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=8h

# 后端服务端口（9000 以上端口）
PORT=9000

# 跨域配置
CORS_ORIGIN=*
