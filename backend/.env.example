# 后端环境变量配置

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=template_db
DB_USER=root
DB_PASSWORD=your_password
DB_CONNECTION_LIMIT=10

# JWT 配置
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRES_IN=7d

# 服务端口
PORT=3000

# 前端地址（CORS）
CORS_ORIGIN=http://localhost:5173

# 学生扫码访问的前端地址（二维码使用此地址）
FRONTEND_PUBLIC_URL=http://localhost:5173
# 固定32字节base64密钥，生成后务必备份；轮换会导致旧卡无法重印
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CARD_PRINT_KEY=
# 私有PDF存储目录，容器部署请挂载持久卷
CARD_PRINT_DIR=./private/card-prints
