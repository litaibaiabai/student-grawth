{
  "name": "express-template",
  "version": "1.0.0",
  "description": "学校六育评价：统一学籍导入、学期积分卡和班主任确认发布",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "migrate": "node scripts/runCoreMigrations.js",
    "test": "NODE_ENV=test node --test __tests__/report_core_*.test.js __tests__/health.test.js",
    "migrate:core": "node scripts/runCoreMigrations.js",
    "test:admin-simplification": "node --test --test-concurrency=1 __tests__/admin_simplification_*.test.js __tests__/report_core_policy.test.js __tests__/report_core_v2_policy.test.js",
    "demo:browser": "node scripts/runFreshThreeRoleDemo.js",
    "demo:replay": "node scripts/runThreeRoleDemo.js --mode replay"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.15.3",
    "pdf-parse": "2.4.5",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "word-extractor": "1.0.4",
    "xlsx": "^0.18.5",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "nodemon": "^3.1.14",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
