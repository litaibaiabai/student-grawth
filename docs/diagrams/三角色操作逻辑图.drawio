        <mxCell id="edge-49" value="监控" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#80928B;strokeWidth=1.8;fontSize=13;labelBackgroundColor=#FCFDFC;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="jobs" target="audit">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note-0" value="卡片终态不可逆：USED / VOID / EXPIRED。&lt;br&gt;月末待审可在校方配置的宽限期内审核；&lt;br&gt;宽限期内入账仍归属卡片原学期。" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontColor=#7D8982;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="743" width="500" height="86.80000000000001" />
        </mxCell>
        <mxCell id="note-1" value="管理员仅可应急代录并写审计；正常无卡直评由教师发起。" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#7D8982;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="1124" width="358" height="30.8" />
        </mxCell>
        <mxCell id="note-2" value="同一学生 / 学期 / 赛事届次只能认定一次。&lt;br&gt;重复与更正以 SPEC 及最终校规为准。" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontColor=#7D8982;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1420" y="1418" width="388" height="61.2" />
        </mxCell>
        <mxCell id="note-3" value="故事缺月显示未完成，不自动按 0 分处理。" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#7D8982;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="1790" width="335" height="34.0" />
        </mxCell>
        <mxCell id="note-4" value="钉钉 / 外部平台先模板导入，接口授权另行确认。" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#7D8982;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1440" y="2112" width="356" height="32.400000000000006" />
        </mxCell>
        <mxCell id="note-5" value="重算触发：&lt;br&gt;管理员手动核算；正式六育成绩新增 / 更新；&lt;br&gt;荣誉通过 / 撤销；激活新规则触发全校重算。" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontColor=#7D8982;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="2432" width="372" height="86.80000000000001" />
        </mxCell>
        <mxCell id="note-6" value="试行示例：权重 80% / 15% / 5%，阈值 20 / 12。&lt;br&gt;实际读取 ACTIVE 规则，不在界面写死。&lt;br&gt;成绩更新后的异步重算仅在可操作学期进行。" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#7D8982;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1420" y="2432" width="530" height="82.0" />
        </mxCell>
        <mxCell id="note-7" value="报告输入还包括：&lt;br&gt;07 综合分和规则版本；03 积分摘要；&lt;br&gt;04 已认定荣誉；05 故事；06 学科成绩。&lt;br&gt;快照独立保存，后续更正不覆盖旧报告。" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontColor=#7D8982;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="2846" width="388" height="112.4" />
        </mxCell>
        <mxCell id="note-8" value="发布六项门禁&lt;br&gt;① 六育均确认　② 规则 ACTIVE&lt;br&gt;③ 班主任已确认　④ 综合分已完成&lt;br&gt;⑤ 快照有效　⑥ 学期 active = 1" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#7D8982;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1410" y="2847" width="350" height="106.0" />
        </mxCell>
        <mxCell id="note-9" value="归档是 08 发布后的独立管理动作，不是等待更正后才归档；右侧归档约束同时作用于整张图。&lt;br&gt;归档后不能恢复正常评分、修改既有行或撤销荣誉；仅按授权走追加冲销与新版报告流程。" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontColor=#7D8982;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="3289" width="724" height="61.2" />
        </mxCell>
        <mxCell id="note-10" value="全局不变量：本校隔离 · 教师班级范围 · 学期时间窗 · 幂等防重 · 历史材料与报告多版本 · 最小化展示个人信息。&lt;br&gt;边界：不设家长账号、积分转赠 / 兑换、在线申诉工单；外部故事合成及试行评分参数待校方确认。" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontColor=#7D8982;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="3656" width="980" height="61.2" />
        </mxCell>
        <mxCell id="legend" value="实线：业务依赖 / 提交；灰虚线：只读查询；暖色：异常 / 退回；淡紫虚线：异步任务。&lt;br&gt;02—06 日常业务并行；07 汇合评价数据，08 汇集报告内容。依据 SPEC V2.1，2026-10-23。" style="text;html=1;align=left;fontSize=17;fontColor=#708276;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="3770" width="2120" height="90" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>