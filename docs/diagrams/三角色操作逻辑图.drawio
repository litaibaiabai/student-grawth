          <mxGeometry as="geometry" x="520" y="1625" width="360" height="118" />
        </mxCell>
        <mxCell id="storyai" value="&lt;b&gt;系统自动 · 保存版本 / 生成 AI 建议&lt;/b&gt;&lt;br&gt;评估中、失败、关闭均可人工评阅 / AI 建议不得直接写作正式成绩&lt;br&gt;&lt;font color=&quot;#89958D&quot;&gt;FR-06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8F9;strokeColor=#B1BEC5;fontColor=#526875;fontSize=14;align=left;spacing=16;" vertex="1" parent="1">
